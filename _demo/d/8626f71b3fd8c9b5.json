"h": "b819110cac", "n": 1, "tag": "a", "t": "Neuigkeiten", "zu": "", "vor": "Über uns", "ober": "", "gleich": 3}, {"h": "2fa364f1c9", "n": 1, "tag": "a", "t": "Kontakt", "zu": "", "vor": "Neuigkeiten", "ober": "", "gleich": 2}, {"h": "53331b391c", "n": 0, "tag": "a", "t": "Jobs", "zu": "", "vor": "Kontakt", "ober": "", "gleich": 2}, {"h": "99dc1c8b98", "n": 0, "tag": "a", "t": "Medien", "zu": "", "vor": "Jobs", "ober": "", "gleich": 2}, {"h": "e18fc1a3e8", "n": 1, "tag": "a", "t": "Tisch reservieren", "zu": "", "vor": "Medien", "ober": "", "gleich": 3}], "fotos": []}, {"h": "41927a6936", "n": 0, "titel": "Kopf und Menü", "tag": "header", "fest": true, "zu": "", "aus": false, "stellen": [{"h": "fa33f47b04", "n": 0, "tag": "h1", "t": "Über uns.", "zu": "", "vor": "", "ober": "", "gleich": 1}, {"h": "abd5f316eb", "n": 0, "tag": "p", "t": "Das Gemüse als Lebensmittelpunkt.", "zu": "", "vor": "Über uns.", "ober": "", "gleich": 1}], "fotos": [{"b": "pascal-kueche", "n": 0, "alt": "Pascal Steffen in der Küche des «roots»", "zu": "", "klein": "assets/img/pascal-kueche-760.webp", "neu": false}]}, {"h": "3c26db9f83", "n": 0, "titel": "Das Gemüse als Lebensmittelpunkt.", "tag": "section", "fest": false, "zu": "", "aus": false, "stellen": [{"h": "3e4654346d", "n": 0, "tag": "h2", "t": "Das Gemüse als Lebensmittelpunkt.", "zu": "", "vor": "", "ober": "", "gleich": 1}, {"h": "7b4c792aec", "n": 0, "tag": "p", "t": "In unserer Küche wird dem Gemüse jener Platz zugewiesen, der ihm gebührt: der Mittelpunkt. Fisch und Fleisch spielen bei uns eine Nebenrolle – wenn auch eine Oscar-verdächtige.", "zu": "", "vor": "Das Gemüse als Lebensmittelpunkt.", "ober": "", "gleich": 1}, {"h": "b3969ada5d", "n": 0, "tag": "p", "t": "Wir konzentrieren uns auf das handwerkliche Können und auf Top-Erzeugnisse, möglichst aus der Region. Jedes unserer Menüs ist von der Saison geprägt – deshalb verändern sich unsere Gerichte laufend.", "zu": "", "vor": "Das Gemüse als Lebensmittelpunkt.", "ober": "", "gleich": 1}, {"h": "e819cab4c8", "n": 0, "tag": "h2", "t": "Zu jung, um mit dem Strom zu schwimmen.", "zu": "", "vor": "Das Gemüse als Lebensmittelpunkt.", "ober": "", "gleich": 1}, {"h": "6bf54d327e", "n": 0, "tag": "p", "t": "Unser Chef in der Küche, Pascal Steffen, ist jung, aber erfahren genug, um Neues wagen zu dürfen. 2018 kürte ihn GaultMillau Schweiz zur Entdeckung des Jahres, auf Anhieb mit 16 Punkten. Stars der Schweizer Gastroszene wie Andreas Caminada und Nenad Mlinarevic waren seine Mentoren.", "zu": "", "vor": "Zu jung, um mit dem Strom zu schwimmen.", "ober": "", "gleich": 1}, {"h": "966fb91550", "n": 0, "tag": "p", "t": "Seit Dezember 2017 hat er diese Erfahrungen bei uns im «roots» gekonnt zu einer eigenen Handschrift weiterentwickelt.", "zu": "", "vor": "Zu jung, um mit dem Strom zu schwimmen.", "ober": "", "gleich": 1}, {"h": "fc302ecfc4", "n": 0, "tag": "h2", "t": "Kompetent kommt nicht von kompliziert.", "zu": "", "vor": "Zu jung, um mit dem Strom zu schwimmen.", "ober": "", "gleich": 1}, {"h": "561390ae49", "n": 0, "tag": "p", "t": "Jenny sorgt seit Februar 2026 dafür, dass Sie im «roots» nicht nur einen top-professionellen, sondern auch einen freundschaftlich warmen und unkomplizierten Service erleben. Vorbereitet hat sie sich in diversen Restaurants in der Schweiz (u.a. Schloss Schauenstein, Memories) und Irland.", "zu": "", "vor": "Kompetent kommt nicht von kompliziert.", "ober": "", "gleich": 1}, {"h": "3cea274ca9", "n": 0, "tag": "p", "t": "Als Restaurantleiterin prägt sie mit ihrer Expertise auch die Auswahl auf unserer Weinkarte.", "zu": "", "vor": "Kompetent kommt nicht von kompliziert.", "ober": "", "gleich": 1}, {"h": "5719a5ed67", "n": 0, "tag": "h2", "t": "Das Essen im «roots» soll Freude und Spass machen.", "zu": "", "vor": "Kompetent kommt nicht von kompliziert.", "ober": "", "gleich": 1}, {"h": "b673bd776a", "n": 0, "tag": "p", "t": "Geführt wird das Restaurant seit seiner Eröffnung 2017 von Dragan Rapic. Der Betriebsökonom und Executive MBA HSG war zuvor Sportchef beim Zürcher Grasshopper Club. Seit Januar 2025 ist Pascal Steffen Teilhaber.", "zu": "", "vor": "Das Essen im «roots» soll Freude und Spass machen.", "ober": "", "gleich": 1}], "fotos": [{"b": "teller-salat", "n": 0, "alt": "Gemüse, Blätter und Blüten auf einem gesprenkelten Teller", "zu": "", "klein": "assets/img/teller-salat-760.webp", "neu": false}, {"b": "teller-schale", "n": 0, "alt": "Gemüse mit Kräutern in einer tiefen Schale", "zu": "", "klein": "assets/img/teller-schale-760.webp", "neu": false}, {"b": "p-jenny-wein", "n": 0, "alt": "Jenny, Restaurantleiterin, schenkt Wein ein", "zu": "", "klein": "assets/img/p-jenny-wein-760.webp", "neu": false}, {"b": "pascal-dragan", "n": 0, "alt": "Pascal Steffen und Dragan Rapic vor der grünen Wand des Saals", "zu": "", "klein": "assets/img/pascal-dragan-760.webp", "neu": false}]}, {"h": "84e5b6e223", "n": 0, "titel": "Die Menschen im «roots».", "tag": "section", "fest": false, "zu": "", "aus": false, "stellen": [{"h": "50ddb93904", "n": 0, "tag": "h2", "t": "Die Menschen im «roots».", "zu": "", "vor": "", "ober": "", "gleich": 1}, {"h": "9a99af6847", "n": 0, "tag": "b", "t": "Pascal", "zu": "", "vor": "Die Menschen im «roots».", "ober": "", "gleich": 1}, {"h": "299892d988", "n": 0, "tag": "span", "t": "Head Chef", "zu": "", "vor": "Pascal", "ober": "", "gleich": 1}, {"h": "60235cb724", "n": 0, "tag": "b", "t": "Malko", "zu": "", "vor": "Head Chef", "ober": "Pascal", "gleich": 1}, {"h": "4204b8b32a", "n": 0, "tag": "span", "t": "Chef de Partie", "zu": "", "vor": "Malko", "ober": "", "gleich": 3}, {"h": "f219f26f65", "n": 0, "tag": "b", "t": "Vanessa", "zu": "", "vor": "Chef de Partie", "ober": "Malko", "gleich": 1}, {"h": "fe3aec90b7", "n": 0, "tag": "span", "t": "Patisserie", "zu": "", "vor": "Vanessa", "ober": "", "gleich": 1}, {"h": "3b504e043b", "n": 0, "tag": "b", "t": "Valentin", "zu": "", "vor": "Patisserie", "ober": "Vanessa", "gleich": 1}, {"h": "4204b8b32a", "n": 1, "tag": "s